#!/usr/bin/env bash

set -eu

operation="${1:-}"
shift || true
printf 'systemctl:%s:%s\n' "$operation" "$*" >> "$NOVA_PHASE4A_TEST_OPERATION_LOG"

case "$operation" in
  mask)
    [[ "${1:-}" == "--runtime" ]] && shift
    for unit in "$@"; do
      : > "$NOVA_PHASE4A_TEST_SYSTEMCTL_STATE/masked/${unit}"
    done
    ;;
  unmask)
    [[ "${1:-}" == "--runtime" ]] && shift
    for unit in "$@"; do
      rm -f -- "$NOVA_PHASE4A_TEST_SYSTEMCTL_STATE/masked/${unit}"
    done
    ;;
  cat)
    case "${1:-}" in
      unbound.service|unbound-resolvconf.service|unbound-resolvconf.path|nftables.service)
        exit 0
        ;;
      docker.service)
        grep -Fqx -- 'docker-ce' "$NOVA_PHASE4A_TEST_PACKAGE_STATE" 2>/dev/null
        ;;
      containerd.service)
        grep -Fqx -- 'containerd.io' "$NOVA_PHASE4A_TEST_PACKAGE_STATE" 2>/dev/null
        ;;
      *)
        exit 1
        ;;
    esac
    ;;
  is-active)
    quiet=0
    if [[ "${1:-}" == "--quiet" ]]; then
      quiet=1
      shift
    fi
    unit="${1:-}"
    if [[ -e "$NOVA_PHASE4A_TEST_SYSTEMCTL_STATE/active/${unit}" ]]; then
      (( quiet == 1 )) || printf '%s\n' 'active'
      exit 0
    fi
    (( quiet == 1 )) || printf '%s\n' 'inactive'
    exit 3
    ;;
  is-enabled)
    unit="${1:-}"
    if [[ -e "$NOVA_PHASE4A_TEST_SYSTEMCTL_STATE/enabled/${unit}" ]]; then
      printf '%s\n' 'enabled'
      exit 0
    fi
    printf '%s\n' 'disabled'
    exit 1
    ;;
  disable)
    [[ "${1:-}" == "--now" ]] && shift
    for unit in "$@"; do
      rm -f -- "$NOVA_PHASE4A_TEST_SYSTEMCTL_STATE/active/${unit}"
      rm -f -- "$NOVA_PHASE4A_TEST_SYSTEMCTL_STATE/enabled/${unit}"
    done
    ;;
  enable)
    start_now=0
    if [[ "${1:-}" == "--now" ]]; then
      start_now=1
      shift
    fi
    for unit in "$@"; do
      : > "$NOVA_PHASE4A_TEST_SYSTEMCTL_STATE/enabled/${unit}"
      if (( start_now == 1 )); then
        : > "$NOVA_PHASE4A_TEST_SYSTEMCTL_STATE/active/${unit}"
      fi
    done
    ;;
  start|restart)
    if [[ "$operation" == "restart" && "${NOVA_PHASE4A_TEST_RESTART_FAIL:-0}" == "1" ]]; then
      exit 4
    fi
    for unit in "$@"; do
      : > "$NOVA_PHASE4A_TEST_SYSTEMCTL_STATE/active/${unit}"
    done
    ;;
  stop)
    for unit in "$@"; do
      rm -f -- "$NOVA_PHASE4A_TEST_SYSTEMCTL_STATE/active/${unit}"
    done
    ;;
  *)
    exit 2
    ;;
esac
