#!/usr/bin/env bash

set -eu

[[ "${1:-}" == "policy" && -n "${2:-}" ]] || exit 2
package="$2"
printf 'apt-cache:policy:%s\n' "$package" >> "$NOVA_PHASE3_TEST_OPERATION_LOG"

if [[ "${NOVA_PHASE3_TEST_REPOSITORY_AVAILABLE:-1}" == "0" ]]; then
  printf '%s:\n  Installed: (none)\n  Candidate: (none)\n  Version table:\n' "$package"
  exit 0
fi

printf '%s:\n' "$package"
printf '  Installed: (none)\n'
printf '  Candidate: 5:99.0.0-1~debian.13~trixie\n'
printf '  Version table:\n'
printf '     5:99.0.0-1~debian.13~trixie 500\n'
printf '        500 https://download.docker.com/linux/debian trixie/stable arm64 Packages\n'
