#!/usr/bin/env bash

set -eu

printf 'docker:%s\n' "$*" >> "$NOVA_PHASE3_TEST_OPERATION_LOG"

case "$*" in
  "--version")
    printf '%s\n' 'Docker version 99.0.0, build test'
    ;;
  "compose version")
    printf '%s\n' 'Docker Compose version v99.0.0'
    ;;
  "info --format {{.ServerVersion}}")
    printf '%s\n' '99.0.0'
    ;;
  "ps")
    exit 0
    ;;
  "ps -aq --no-trunc")
    if [[ -f "$NOVA_PHASE3_TEST_CONTAINER_STATE" ]]; then
      cat -- "$NOVA_PHASE3_TEST_CONTAINER_STATE"
    fi
    ;;
  *)
    printf 'Unexpected Docker command in Phase 3 test: %s\n' "$*" >&2
    exit 97
    ;;
esac
