#!/usr/bin/env bash

set -eu

if (( $# != 5 )) \
  || [[ "$1" != '-o' || "$2" != 'ro,nosuid,nodev,noexec' \
  || "$3" != '--' || "$4" != '/dev/mock-infra-recovery' ]]; then
  exit 2
fi

mountpoint="$5"
mkdir -- "${mountpoint}/secrets"
cp -- "${NOVA_MOCK_RECOVERY_SOURCE}/secrets/secrets.env" \
  "${mountpoint}/secrets/secrets.env"
printf '%s\n' "$mountpoint" > "$NOVA_MOCK_MOUNT_STATE"
printf 'mount:%s:ro,nosuid,nodev,noexec\n' "$mountpoint" >> "$NOVA_MOCK_MOUNT_LOG"
