#!/bin/bash

# ---------- colors ----------
C_RESET=$'\e[0m'
C_DIM=$'\e[2m'
C_BOLD=$'\e[1m'
C_CYAN=$'\e[36m'
C_GREEN=$'\e[32m'
C_YELLOW=$'\e[33m'
C_RED=$'\e[31m'

# ---------- helpers ----------
have_cmd() { command -v "$1" >/dev/null 2>&1; }

# ---------- temperature ----------
get_temp_c() {
  if have_cmd vcgencmd; then
    vcgencmd measure_temp | sed "s/temp=//;s/'C//"
    return
  fi
  [ -r /sys/class/thermal/thermal_zone0/temp ] &&
    awk '{printf "%.1f\n", $1/1000}' /sys/class/thermal/thermal_zone0/temp
}

to_tenths() {
  local s="$1"
  local ip="${s%%.*}"
  local fp="0"
  [[ "$s" == *.* ]] && fp="${s#*.}" && fp="${fp:0:1}"
  ip="${ip//[^0-9]/}"
  fp="${fp//[^0-9]/}"
  echo $((10*ip + fp))
}

# ---------- header ----------
echo
echo "${C_CYAN}${C_BOLD}╭────────────────────────────────────────────╮${C_RESET}"
printf "${C_CYAN}${C_BOLD}│ %-42s │${C_RESET}\n" "Raspberry Infrastructure Node"
echo "${C_CYAN}${C_BOLD}╰────────────────────────────────────────────╯${C_RESET}"

echo "${C_DIM} Host:${C_RESET}     $(hostname)"
echo "${C_DIM} Owner:${C_RESET}    Oliver Bertrand"
echo "${C_DIM} Managed:${C_RESET}  infra.git (manual changes discouraged)"

# ---------- system ----------
echo
echo "${C_RED}${C_BOLD}System${C_RESET}"
echo "  Uptime:  $(uptime -p)"
echo "  Load:    $(cut -d' ' -f1-3 /proc/loadavg)"
if [ -e /run/reboot-required ]; then
  echo "  Reboot:  ${C_YELLOW}required${C_RESET}"
else
  echo "  Reboot:  ${C_GREEN}not required${C_RESET}"
fi

# ---------- resources ----------
echo
echo "${C_RED}${C_BOLD}Resources${C_RESET}"

if have_cmd df; then
  read -r TOTAL USED PCT <<<"$(df -h / | awk 'NR==2 {print $2, $3, $5}' | tr -d '%')"
  DCOLOR="$C_GREEN"
  [ "$PCT" -ge 90 ] && DCOLOR="$C_RED"
  [ "$PCT" -ge 80 ] && [ "$PCT" -lt 90 ] && DCOLOR="$C_YELLOW"
  echo "  Disk:    ${USED}/${TOTAL} (${DCOLOR}${PCT}%${C_RESET})"
fi

have_cmd free && echo "  RAM:     $(free -h | awk '/Mem:/ {print $3 "/" $2}')"

TEMP="$(get_temp_c)"
if [ -n "$TEMP" ]; then
  T10="$(to_tenths "$TEMP")"
  TCOLOR="$C_GREEN"
  [ "$T10" -ge 750 ] && TCOLOR="$C_RED"
  [ "$T10" -ge 600 ] && [ "$T10" -lt 750 ] && TCOLOR="$C_YELLOW"
  echo "  Temp:    ${TCOLOR}${TEMP}°C${C_RESET}"
fi

# ---------- services ----------
echo
echo "${C_RED}${C_BOLD}Services${C_RESET}"

for svc in unbound unattended-upgrades dyndns.timer syncthing@admin; do

  # ---- timer ----
  if [[ "$svc" == *.timer ]]; then
    if systemctl cat "$svc" >/dev/null 2>&1; then
      if systemctl is-enabled --quiet "$svc"; then
        printf "  %s●%s %-24s %12s\n" "$C_GREEN" "$C_RESET" "$svc" "enabled"
      else
        printf "  %s○%s %-24s %12s\n" "$C_YELLOW" "$C_RESET" "$svc" "disabled"
      fi
    else
      printf "  %s○%s %-24s %12s\n" "$C_DIM" "$C_RESET" "$svc" "not installed"
    fi

  # ---- normal service ----
  else
    unit="${svc}.service"
    if systemctl cat "$unit" >/dev/null 2>&1; then
      if systemctl is-active --quiet "$unit"; then
        printf "  %s●%s %-24s %12s\n" "$C_GREEN" "$C_RESET" "$svc" "running"
      else
        printf "  %s○%s %-24s %12s\n" "$C_YELLOW" "$C_RESET" "$svc" "stopped"
      fi
    else
      printf "  %s○%s %-24s %12s\n" "$C_DIM" "$C_RESET" "$svc" "not installed"
    fi
  fi
done

# ---------- docker ----------
if have_cmd docker; then
  echo
  echo "${C_RED}${C_BOLD}Docker${C_RESET}"
  EXPECTED_CONTAINERS=(prusa-monitor prusa-connect-rtsp adguardhome wg-easy caddy vaultwarden)
  RUNNING=0
  DOCKER_READY=0
  docker info >/dev/null 2>&1 && DOCKER_READY=1
  if [ "$DOCKER_READY" -eq 1 ]; then
    for name in "${EXPECTED_CONTAINERS[@]}"; do
      state="$(docker ps -a --filter "name=^/${name}$" --format '{{.State}}|{{.Status}}' | head -n1)"
      [ "${state%%|*}" = "running" ] && RUNNING=$((RUNNING + 1))
    done
    echo "  Containers: ${RUNNING}/6 running"
    for name in "${EXPECTED_CONTAINERS[@]}"; do
      state="$(docker ps -a --filter "name=^/${name}$" --format '{{.State}}|{{.Status}}' | head -n1)"
      if [ -z "$state" ]; then
        printf "   %s○%s %-22s %s%s%s\n" "$C_DIM" "$C_RESET" "$name" "$C_DIM" "not present" "$C_RESET"
      else
        status="${state#*|}"
        if [ "${state%%|*}" = "running" ]; then
          printf "   %s●%s %-22s %s%s%s\n" "$C_GREEN" "$C_RESET" "$name" "$C_DIM" "$status" "$C_RESET"
        else
          printf "   %s○%s %-22s %s%s%s\n" "$C_RED" "$C_RESET" "$name" "$C_DIM" "$status" "$C_RESET"
        fi
      fi
    done
  else
    echo "  Containers: 0/6 running (Docker unavailable)"
    for name in "${EXPECTED_CONTAINERS[@]}"; do
      printf "   %s○%s %-22s %s%s%s\n" "$C_DIM" "$C_RESET" "$name" "$C_DIM" "not available" "$C_RESET"
    done
  fi
fi

# ---------- footer ----------
echo
