#!/usr/bin/env bash

set -Eeuo pipefail

ORIGINAL_DIRECTORY="$PWD"
restore_directory() {
  cd -- "$ORIGINAL_DIRECTORY" || true
}
trap restore_directory EXIT

update_vaultwarden() {
  local stack=/opt/vaultwarden
  if [[ ! -d "$stack" ]]; then
    printf '[INFO] Skipping %s (directory not present).\n' "$stack"
    return 0
  fi
  if [[ ! -f "${stack}/docker-compose.yml" || ! -f "${stack}/docker-compose.override.yml" || ! -f "${stack}/docker-compose.vwctl.yml" ]]; then
    printf '[ERROR] Compose project is incomplete: %s.\n' "$stack" >&2
    exit 1
  fi
  printf '[INFO] Updating %s (Vaultwarden and Caddy).\n' "$stack"
  if ! (
    cd -- "$stack"
    docker compose -f docker-compose.yml -f docker-compose.override.yml -f docker-compose.vwctl.yml pull
    docker compose -f docker-compose.yml -f docker-compose.override.yml -f docker-compose.vwctl.yml up -d
  ); then
    printf '[ERROR] Compose update failed for %s.\n' "$stack" >&2
    exit 1
  fi
}

update_stack() {
  local stack="$1" compose_file
  if [[ -f "${stack}/compose.yml" ]]; then
    compose_file=compose.yml
  elif [[ -f "${stack}/docker-compose.yml" ]]; then
    compose_file=docker-compose.yml
  else
    printf '[INFO] Skipping %s (no Compose file).\n' "$stack"
    return 0
  fi

  printf '[INFO] Updating %s.\n' "$stack"
  if ! (
    cd -- "$stack"
    docker compose -f "$compose_file" pull
    docker compose -f "$compose_file" up -d
  ); then
    printf '[ERROR] Compose update failed for %s.\n' "$stack" >&2
    exit 1
  fi
}

update_vaultwarden
update_stack /opt/wg-easy
update_stack /opt/adguard
update_stack /opt/prusa

printf '[INFO] Removing unused Docker images.\n'
docker image prune -a -f
